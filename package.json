{
  "name": "muse-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "smoke:native": "node scripts/native-smoke.mjs",
    "release:update": "node scripts/release-update.mjs",
    "release:delta": "node scripts/release-delta.mjs",
    "release:channel": "node scripts/release-channel.mjs",
    "release:fetch": "node scripts/release-fetch.mjs",
    "release:orchestrate": "node scripts/release-orchestrator.mjs",
    "release:launch": "node scripts/release-launcher.mjs",
    "release:installer": "node scripts/release-launcher.mjs installer",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:clean": "sh scripts/dev-clean.sh",
    "dev:clean:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-clean.ps1"
  },
  "dependencies": {
    "@muse-code/sdk": "0.1.1",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.1.0",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-shell": "^2.1.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.5.0",
    "vite": "^6.0.0"
  }
}
