# Dependencies
node_modules/
dist/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/

# Sidecar binaries: ignore per-platform triple-suffixed binaries,
# but keep the placeholder docs (see src-tauri/binaries/README.md).
src-tauri/binaries/muse-*
!src-tauri/binaries/.gitkeep
!src-tauri/binaries/README.md

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Local WSL adapter build
scripts/wsl-bridge/target/

# Working directories produced by image analysis during a review: crops and zooms
# are derived from the captures next to them and are not evidence themselves.
**/_crops/
**/_zoom/

# Claude Code local state: session worktrees live here.
.claude/
