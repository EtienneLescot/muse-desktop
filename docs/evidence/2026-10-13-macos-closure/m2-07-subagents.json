  "ticket": "M2-07",
  "date": "2026-10-13",
  "commit": "08b291d",
  "platform": "macOS 26.5 (25F71), arm64, Apple Silicon; debug build 08b291d with embedded frontend, WKWebView through the test bridge",
  "engine": "Muse Code 1.4.2 (1.4.2-R4684.1)",
  "liveTurns": 2,
  "harness": "scripts/macos/m2-07-subagents.mjs on scripts/macos/test-instance.mjs, bridge port 9456",
  "method": "One isolated instance, global posture Yolo (allowAll) in its own data folder so the children's shell steps run without cards. Two conversations in two project folders started from the welcome screen (typed message, real Enter). Lane states are read from each conversation's stored log every second (both threads at the same instant); controls are the lane block's own buttons in the DOM. The sub-agent processes are counted under the app with ps (`sleep 45`).",
  "prompts": {
    "A": "M2-07 macOS proof. Start three sub-agents at the same time, in parallel, without waiting for one before starting the next. Each sub-agent must run the shell command `sleep 45` and then answer with the single word DONE. Do not wait for them to finish: as soon as the three are started, reply with just the word SPAWNED.",
    "B": "M2-07 macOS proof, second thread. Start two sub-agents at the same time, in parallel. Each sub-agent must run the shell command `sleep 45` and then answer with the single word DONE. Do not wait for them: once both are started, reply with just the word SPAWNED."
  },
  "isolation": {
    "data": "<proof>/data",
    "store": "~/Library/WebKit/muse-desktop/WebsiteDataStore/<e3abe330-e519-5ef1-9961-07289a8e623d>",
    "defaultStoresUnchangedAtStart": true
  },
  "posture": [
    "Current posture: YOLO",
    "Current isolation: Workspace only"
  ],
  "startA": "ready",
  "startB": "ready",
